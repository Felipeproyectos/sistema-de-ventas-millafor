{
  "name": "ReportTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nombre de la plantilla"
    },
    "type": {
      "type": "string",
      "enum": [
        "repair",
        "sale",
        "inventory",
        "financial",
        "custom"
      ],
      "title": "Tipo"
    },
    "header_text": {
      "type": "string",
      "title": "Texto de encabezado"
    },
    "footer_text": {
      "type": "string",
      "title": "Texto de pie de p\u00e1gina"
    },
    "include_logo": {
      "type": "boolean",
      "title": "Incluir logo",
      "default": true
    },
    "include_company_info": {
      "type": "boolean",
      "title": "Incluir info de empresa",
      "default": true
    },
    "content_template": {
      "type": "string",
      "title": "Contenido de la plantilla"
    }
  },
  "required": [
    "name",
    "type"
  ]
}